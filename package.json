{
  "name": "spareparts",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "src/admin-web",
    "src/public-web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:admin": "npm run dev --workspace=@spareparts/admin-web",
    "dev:public": "npm run dev --workspace=@spareparts/public-web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,html}\"",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "8.46.0"
  }
}
